{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://thermal.local/schema/job.v1.json",
  "title": "Thermal print job",
  "description": "A print job made of blocks, accepted by POST /v1/print/json. The body is either a document object or a bare array of blocks.",
  "oneOf": [
    {
      "$ref": "#/$defs/document"
    },
    {
      "$ref": "#/$defs/blocks"
    }
  ],
  "$defs": {
    "align": {
      "enum": [
        "left",
        "center",
        "right"
      ]
    },
    "style": {
      "type": "object",
      "additionalProperties": false,
      "description": "Character and block style as CSS properties, written like React's CSSProperties (camelCase names; numbers mean px for lengths). The same object renders in a browser on top of escpos.css (served at /escpos.css), at one CSS pixel per printer dot. Inside a group, inherited properties come from the group, as in CSS. Values a thermal printer cannot reproduce are rejected when the job is rendered.",
      "properties": {
        "fontFamily": {
          "type": "string",
          "description": "\"Font A\" (12×24 dots, 48 columns on 80 mm) or \"Font B\" (9×17, 64 columns). A list such as \"Font B, monospace\" is accepted.",
          "examples": [
            "Font A",
            "Font B"
          ]
        },
        "fontSize": {
          "type": [
            "string",
            "number"
          ],
          "description": "Character size: 24px is normal and 48px double, up to 192px (×8); em, rem and % work too.",
          "examples": [
            24,
            48,
            "2em"
          ]
        },
        "fontWeight": {
          "type": [
            "string",
            "number"
          ],
          "description": "normal, bold, bolder, lighter or 1–1000. 600 and up prints bold; 800 and up adds double-strike.",
          "examples": [
            "bold",
            700
          ]
        },
        "textDecoration": {
          "type": "string",
          "description": "underline or none, optionally with double (a 2-dot line) or a thickness of 1px or 2px.",
          "examples": [
            "underline",
            "underline double",
            "none"
          ]
        },
        "textDecorationLine": {
          "type": "string",
          "description": "underline or none.",
          "enum": [
            "underline",
            "none"
          ]
        },
        "textDecorationStyle": {
          "type": "string",
          "description": "solid (1-dot line) or double (2-dot line).",
          "enum": [
            "solid",
            "double"
          ]
        },
        "textDecorationThickness": {
          "type": [
            "string",
            "number"
          ],
          "description": "1px or 2px.",
          "examples": [
            1,
            "2px"
          ]
        },
        "textAlign": {
          "type": "string",
          "description": "Line justification.",
          "enum": [
            "left",
            "center",
            "right",
            "start",
            "end"
          ]
        },
        "color": {
          "type": "string",
          "description": "black, or white with a black background. Thermal printers print one colour.",
          "examples": [
            "black",
            "white",
            "#000",
            "#fff"
          ]
        },
        "backgroundColor": {
          "type": "string",
          "description": "black prints white-on-black (inverted) text; white or transparent is normal.",
          "examples": [
            "black",
            "white",
            "transparent"
          ]
        },
        "lineHeight": {
          "type": [
            "string",
            "number"
          ],
          "description": "Line spacing: normal (30 dots), a multiple of the font size such as 1.5, or a length such as \"40px\".",
          "examples": [
            "normal",
            1.5,
            "40px"
          ]
        },
        "letterSpacing": {
          "type": [
            "string",
            "number"
          ],
          "description": "Extra space after each character in px (ESC SP).",
          "examples": [
            2,
            "4px"
          ]
        },
        "textTransform": {
          "type": "string",
          "description": "Changes the case of the text before printing.",
          "enum": [
            "none",
            "uppercase",
            "lowercase",
            "capitalize"
          ]
        },
        "whiteSpace": {
          "type": "string",
          "description": "nowrap and pre turn word wrapping off; the printer then breaks lines wherever they fill.",
          "enum": [
            "normal",
            "nowrap",
            "pre",
            "pre-wrap",
            "pre-line",
            "break-spaces"
          ]
        },
        "transform": {
          "type": "string",
          "description": "scale(x[, y]), scaleX() and scaleY() set width and height multipliers relative to fontSize; rotate() turns characters by 90deg, 180deg or 270deg.",
          "examples": [
            "scale(2, 1)",
            "scaleY(3)",
            "rotate(180deg)"
          ]
        },
        "marginLeft": {
          "type": [
            "string",
            "number"
          ],
          "description": "Left margin of the block in px (GS L). Not inherited, but applies to everything inside a group.",
          "examples": [
            48
          ]
        },
        "width": {
          "type": [
            "string",
            "number"
          ],
          "description": "Printable width of the block in px (GS W), or auto.",
          "examples": [
            384,
            "auto"
          ]
        },
        "borderStyle": {
          "type": "string",
          "enum": [
            "solid",
            "double"
          ],
          "description": "Lines of a box drawn around the block (alert): solid (┌─┐) or double (╔═╗). Not inherited."
        }
      }
    },
    "blocks": {
      "type": "array",
      "maxItems": 2000,
      "items": {
        "$ref": "#/$defs/block"
      }
    },
    "block": {
      "type": "object",
      "required": [
        "type"
      ],
      "properties": {
        "type": {
          "enum": [
            "alert",
            "barcode",
            "beep",
            "box",
            "charset",
            "code_page",
            "columns",
            "counter",
            "cut",
            "datetime",
            "drawer",
            "feed",
            "group",
            "heading",
            "image",
            "initialize",
            "key_value",
            "line_spacing",
            "list",
            "margins",
            "markdown",
            "page",
            "pdf417",
            "qr_code",
            "raw",
            "rule",
            "self_test",
            "table",
            "text",
            "unicode",
            "utf8"
          ],
          "description": "The kind of block."
        }
      },
      "allOf": [
        {
          "if": {
            "properties": {
              "type": {
                "const": "text"
              }
            },
            "required": [
              "type"
            ]
          },
          "then": {
            "$ref": "#/$defs/block_text"
          }
        },
        {
          "if": {
            "properties": {
              "type": {
                "const": "heading"
              }
            },
            "required": [
              "type"
            ]
          },
          "then": {
            "$ref": "#/$defs/block_heading"
          }
        },
        {
          "if": {
            "properties": {
              "type": {
                "const": "markdown"
              }
            },
            "required": [
              "type"
            ]
          },
          "then": {
            "$ref": "#/$defs/block_markdown"
          }
        },
        {
          "if": {
            "properties": {
              "type": {
                "const": "unicode"
              }
            },
            "required": [
              "type"
            ]
          },
          "then": {
            "$ref": "#/$defs/block_unicode"
          }
        },
        {
          "if": {
            "properties": {
              "type": {
                "const": "utf8"
              }
            },
            "required": [
              "type"
            ]
          },
          "then": {
            "$ref": "#/$defs/block_utf8"
          }
        },
        {
          "if": {
            "properties": {
              "type": {
                "const": "feed"
              }
            },
            "required": [
              "type"
            ]
          },
          "then": {
            "$ref": "#/$defs/block_feed"
          }
        },
        {
          "if": {
            "properties": {
              "type": {
                "const": "rule"
              }
            },
            "required": [
              "type"
            ]
          },
          "then": {
            "$ref": "#/$defs/block_rule"
          }
        },
        {
          "if": {
            "properties": {
              "type": {
                "const": "key_value"
              }
            },
            "required": [
              "type"
            ]
          },
          "then": {
            "$ref": "#/$defs/block_key_value"
          }
        },
        {
          "if": {
            "properties": {
              "type": {
                "const": "columns"
              }
            },
            "required": [
              "type"
            ]
          },
          "then": {
            "$ref": "#/$defs/block_columns"
          }
        },
        {
          "if": {
            "properties": {
              "type": {
                "const": "table"
              }
            },
            "required": [
              "type"
            ]
          },
          "then": {
            "$ref": "#/$defs/block_table"
          }
        },
        {
          "if": {
            "properties": {
              "type": {
                "const": "list"
              }
            },
            "required": [
              "type"
            ]
          },
          "then": {
            "$ref": "#/$defs/block_list"
          }
        },
        {
          "if": {
            "properties": {
              "type": {
                "const": "box"
              }
            },
            "required": [
              "type"
            ]
          },
          "then": {
            "$ref": "#/$defs/block_box"
          }
        },
        {
          "if": {
            "properties": {
              "type": {
                "const": "qr_code"
              }
            },
            "required": [
              "type"
            ]
          },
          "then": {
            "$ref": "#/$defs/block_qr_code"
          }
        },
        {
          "if": {
            "properties": {
              "type": {
                "const": "barcode"
              }
            },
            "required": [
              "type"
            ]
          },
          "then": {
            "$ref": "#/$defs/block_barcode"
          }
        },
        {
          "if": {
            "properties": {
              "type": {
                "const": "pdf417"
              }
            },
            "required": [
              "type"
            ]
          },
          "then": {
            "$ref": "#/$defs/block_pdf417"
          }
        },
        {
          "if": {
            "properties": {
              "type": {
                "const": "image"
              }
            },
            "required": [
              "type"
            ]
          },
          "then": {
            "$ref": "#/$defs/block_image"
          }
        },
        {
          "if": {
            "properties": {
              "type": {
                "const": "cut"
              }
            },
            "required": [
              "type"
            ]
          },
          "then": {
            "$ref": "#/$defs/block_cut"
          }
        },
        {
          "if": {
            "properties": {
              "type": {
                "const": "drawer"
              }
            },
            "required": [
              "type"
            ]
          },
          "then": {
            "$ref": "#/$defs/block_drawer"
          }
        },
        {
          "if": {
            "properties": {
              "type": {
                "const": "beep"
              }
            },
            "required": [
              "type"
            ]
          },
          "then": {
            "$ref": "#/$defs/block_beep"
          }
        },
        {
          "if": {
            "properties": {
              "type": {
                "const": "raw"
              }
            },
            "required": [
              "type"
            ]
          },
          "then": {
            "$ref": "#/$defs/block_raw"
          }
        },
        {
          "if": {
            "properties": {
              "type": {
                "const": "initialize"
              }
            },
            "required": [
              "type"
            ]
          },
          "then": {
            "$ref": "#/$defs/block_initialize"
          }
        },
        {
          "if": {
            "properties": {
              "type": {
                "const": "code_page"
              }
            },
            "required": [
              "type"
            ]
          },
          "then": {
            "$ref": "#/$defs/block_code_page"
          }
        },
        {
          "if": {
            "properties": {
              "type": {
                "const": "charset"
              }
            },
            "required": [
              "type"
            ]
          },
          "then": {
            "$ref": "#/$defs/block_charset"
          }
        },
        {
          "if": {
            "properties": {
              "type": {
                "const": "line_spacing"
              }
            },
            "required": [
              "type"
            ]
          },
          "then": {
            "$ref": "#/$defs/block_line_spacing"
          }
        },
        {
          "if": {
            "properties": {
              "type": {
                "const": "margins"
              }
            },
            "required": [
              "type"
            ]
          },
          "then": {
            "$ref": "#/$defs/block_margins"
          }
        },
        {
          "if": {
            "properties": {
              "type": {
                "const": "group"
              }
            },
            "required": [
              "type"
            ]
          },
          "then": {
            "$ref": "#/$defs/block_group"
          }
        },
        {
          "if": {
            "properties": {
              "type": {
                "const": "page"
              }
            },
            "required": [
              "type"
            ]
          },
          "then": {
            "$ref": "#/$defs/block_page"
          }
        },
        {
          "if": {
            "properties": {
              "type": {
                "const": "counter"
              }
            },
            "required": [
              "type"
            ]
          },
          "then": {
            "$ref": "#/$defs/block_counter"
          }
        },
        {
          "if": {
            "properties": {
              "type": {
                "const": "datetime"
              }
            },
            "required": [
              "type"
            ]
          },
          "then": {
            "$ref": "#/$defs/block_datetime"
          }
        },
        {
          "if": {
            "properties": {
              "type": {
                "const": "self_test"
              }
            },
            "required": [
              "type"
            ]
          },
          "then": {
            "$ref": "#/$defs/block_self_test"
          }
        },
        {
          "if": {
            "properties": {
              "type": {
                "const": "alert"
              }
            },
            "required": [
              "type"
            ]
          },
          "then": {
            "$ref": "#/$defs/block_alert"
          }
        }
      ]
    },
    "options": {
      "type": "object",
      "properties": {
        "cut": {
          "enum": [
            "none",
            "partial",
            "full"
          ],
          "description": "How the job ends.",
          "default": "partial"
        },
        "feed": {
          "type": "integer",
          "minimum": 0,
          "maximum": 255,
          "description": "Dots of paper fed past the last line before the cut (8 dots = 1 mm). Defaults to the server's THERMAL_CUT_FEED (96, i.e. 12 mm), or 0 when cut is none."
        },
        "copies": {
          "type": "integer",
          "minimum": 1,
          "maximum": 20,
          "default": 1
        },
        "priority": {
          "type": "integer",
          "minimum": -100,
          "maximum": 100,
          "description": "Higher priorities print first.",
          "default": 0
        },
        "open_drawer": {
          "type": "boolean",
          "description": "Kick the cash drawer after printing.",
          "default": false
        },
        "beep": {
          "type": "boolean",
          "description": "Beep after printing.",
          "default": false
        },
        "unicode": {
          "enum": [
            "image",
            "transliterate"
          ],
          "description": "How text blocks print characters the printer's fonts lack.",
          "default": "image"
        }
      },
      "additionalProperties": false
    },
    "document": {
      "type": "object",
      "properties": {
        "$schema": {
          "type": "string"
        },
        "version": {
          "const": 1,
          "description": "Schema version."
        },
        "metadata": {
          "type": "object",
          "description": "Free-form data stored with the job. label is shown in the job list.",
          "properties": {
            "label": {
              "type": "string",
              "maxLength": 200
            }
          }
        },
        "options": {
          "$ref": "#/$defs/options"
        },
        "blocks": {
          "$ref": "#/$defs/blocks"
        }
      },
      "additionalProperties": false,
      "required": [
        "blocks"
      ]
    },
    "block_text": {
      "type": "object",
      "properties": {
        "type": {
          "const": "text"
        },
        "content": {
          "type": "string",
          "description": "Text to print. Characters the printer's fonts lack (emoji, CJK, ...) are drawn as an image when options.unicode is \"image\".",
          "maxLength": 65536
        },
        "spans": {
          "type": "array",
          "description": "Rich text: runs with their own styles, printed as one paragraph.",
          "minItems": 1,
          "maxItems": 500,
          "items": {
            "type": "object",
            "properties": {
              "content": {
                "type": "string",
                "maxLength": 65536
              },
              "style": {
                "$ref": "#/$defs/style"
              }
            },
            "additionalProperties": false,
            "required": [
              "content"
            ]
          }
        },
        "style": {
          "$ref": "#/$defs/style"
        },
        "align": {
          "$ref": "#/$defs/align"
        },
        "wrap": {
          "type": "boolean",
          "description": "Word-wrap at the paper width. When false the printer wraps mid-word.",
          "default": true
        }
      },
      "additionalProperties": false,
      "required": [
        "type"
      ],
      "description": "A paragraph of text, word-wrapped to the paper width. Give either content or spans.",
      "oneOf": [
        {
          "required": [
            "content"
          ]
        },
        {
          "required": [
            "spans"
          ]
        }
      ]
    },
    "block_heading": {
      "type": "object",
      "properties": {
        "type": {
          "const": "heading"
        },
        "content": {
          "type": "string",
          "description": "Text to print. Characters the printer's fonts lack (emoji, CJK, ...) are drawn as an image when options.unicode is \"image\".",
          "maxLength": 65536
        },
        "level": {
          "type": "integer",
          "minimum": 1,
          "maximum": 6,
          "default": 1
        },
        "align": {
          "$ref": "#/$defs/align"
        }
      },
      "additionalProperties": false,
      "required": [
        "type",
        "content"
      ],
      "description": "A heading in the same styles as Markdown headings."
    },
    "block_markdown": {
      "type": "object",
      "properties": {
        "type": {
          "const": "markdown"
        },
        "content": {
          "type": "string",
          "maxLength": 262144
        },
        "links": {
          "enum": [
            "inline",
            "footnotes",
            "qr",
            "hide"
          ],
          "description": "How links are printed.",
          "default": "inline"
        },
        "images": {
          "type": "boolean",
          "description": "Print ![images](src). When false the alt text is printed.",
          "default": true
        }
      },
      "additionalProperties": false,
      "required": [
        "type",
        "content"
      ],
      "description": "GitHub-flavoured Markdown: headings, emphasis, lists, task lists, tables, quotes, code, links, images, footnotes and :emoji: shortcodes."
    },
    "block_unicode": {
      "type": "object",
      "properties": {
        "type": {
          "const": "unicode"
        },
        "content": {
          "type": "string",
          "maxLength": 65536
        },
        "scale": {
          "type": "number",
          "minimum": 1,
          "maximum": 8,
          "default": 2,
          "description": "Dots per font pixel. The default, 2, matches the height of the printer's Font A and prints each pixel as an even 2×2 block."
        },
        "bold": {
          "type": "boolean",
          "default": false
        },
        "invert": {
          "type": "boolean",
          "description": "White on black.",
          "default": false
        },
        "align": {
          "$ref": "#/$defs/align"
        },
        "line_gap": {
          "type": "integer",
          "minimum": 0,
          "maximum": 255,
          "description": "Extra dots between lines."
        },
        "wrap": {
          "type": "boolean",
          "default": true
        },
        "weight": {
          "type": "integer",
          "minimum": 0,
          "maximum": 4,
          "description": "Extra dots added to each stroke of non-emoji glyphs. Default 1 below scale 2, where some strokes would otherwise print a single dot wide."
        },
        "solid_emoji": {
          "type": "boolean",
          "default": false,
          "description": "Print emoji solid black. By default their solid areas are shaded grey, which reads better next to text."
        }
      },
      "additionalProperties": false,
      "required": [
        "type",
        "content"
      ],
      "description": "Text drawn as an image with GNU Unifont, so every Unicode character prints: emoji, kanji, Arabic, symbols. Arabic and Hebrew are not shaped or reordered."
    },
    "block_utf8": {
      "type": "object",
      "properties": {
        "type": {
          "const": "utf8"
        },
        "content": {
          "type": "string",
          "maxLength": 65536
        },
        "scale": {
          "type": "number",
          "minimum": 1,
          "maximum": 8,
          "default": 2,
          "description": "Dots per font pixel. The default, 2, matches the height of the printer's Font A and prints each pixel as an even 2×2 block."
        },
        "bold": {
          "type": "boolean",
          "default": false
        },
        "invert": {
          "type": "boolean",
          "description": "White on black.",
          "default": false
        },
        "align": {
          "$ref": "#/$defs/align"
        },
        "line_gap": {
          "type": "integer",
          "minimum": 0,
          "maximum": 255,
          "description": "Extra dots between lines."
        },
        "wrap": {
          "type": "boolean",
          "default": true
        },
        "weight": {
          "type": "integer",
          "minimum": 0,
          "maximum": 4,
          "description": "Extra dots added to each stroke of non-emoji glyphs. Default 1 below scale 2, where some strokes would otherwise print a single dot wide."
        },
        "solid_emoji": {
          "type": "boolean",
          "default": false,
          "description": "Print emoji solid black. By default their solid areas are shaded grey, which reads better next to text."
        }
      },
      "additionalProperties": false,
      "required": [
        "type",
        "content"
      ],
      "description": "Alias of unicode."
    },
    "block_feed": {
      "type": "object",
      "properties": {
        "type": {
          "const": "feed"
        },
        "lines": {
          "type": "integer",
          "minimum": 0,
          "maximum": 255
        },
        "dots": {
          "type": "integer",
          "minimum": 0,
          "maximum": 255,
          "description": "1 dot is 0.125 mm."
        }
      },
      "additionalProperties": false,
      "required": [
        "type"
      ],
      "description": "Feed paper. Give lines or dots.",
      "oneOf": [
        {
          "required": [
            "lines"
          ]
        },
        {
          "required": [
            "dots"
          ]
        }
      ]
    },
    "block_rule": {
      "type": "object",
      "properties": {
        "type": {
