          "type": "integer",
          "minimum": 1,
          "maximum": 255,
          "description": "Bar height in dots.",
          "default": 80
        },
        "width": {
          "type": "integer",
          "minimum": 2,
          "maximum": 6,
          "description": "Module width in dots.",
          "default": 3
        },
        "hri": {
          "enum": [
            "none",
            "above",
            "below",
            "both"
          ],
          "description": "Where the human-readable text goes.",
