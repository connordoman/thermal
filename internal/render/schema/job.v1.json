{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://thermal.local/schema/job.v1.json",
  "title": "Thermal print job",
  "description": "A print job made of blocks, accepted by POST /v1/print/json. The body is either a document object or a bare array of blocks.",
  "oneOf": [
    {
      "$ref": "#/$defs/document"
    },
    {
      "$ref": "#/$defs/blocks"
    }
  ],
  "$defs": {
    "align": {
      "enum": [
        "left",
        "center",
        "right"
      ]
    },
    "style": {
      "type": "object",
      "properties": {
        "bold": {
          "type": "boolean"
        },
        "underline": {
          "oneOf": [
            {
              "type": "boolean"
            },
            {
              "type": "integer",
              "minimum": 0,
              "maximum": 2
            }
          ],
          "description": "true or 1 for a 1-dot line, 2 for 2 dots."
        },
        "double_strike": {
          "type": "boolean"
        },
        "invert": {
          "type": "boolean",
          "description": "White on black."
        },
        "font": {
          "enum": [
            "A",
            "B"
          ],
          "description": "A is 12×24 dots (48 columns on 80 mm), B is 9×17 (64 columns)."
        },
        "size": {
          "type": "integer",
          "minimum": 1,
          "maximum": 8,
          "description": "Sets width and height together."
        },
        "width": {
          "type": "integer",
          "minimum": 1,
          "maximum": 8,
          "description": "Character width multiplier."
        },
        "height": {
          "type": "integer",
          "minimum": 1,
          "maximum": 8,
          "description": "Character height multiplier."
        },
        "upside_down": {
          "type": "boolean"
        }
      },
      "additionalProperties": false,
      "description": "Character style. Inside a group, unset fields inherit the group's style."
    },
    "blocks": {
      "type": "array",
      "maxItems": 2000,
      "items": {
        "$ref": "#/$defs/block"
      }
    },
    "block": {
      "type": "object",
      "required": [
        "type"
      ],
      "properties": {
        "type": {
          "enum": [
            "barcode",
            "beep",
            "box",
            "charset",
            "code_page",
            "columns",
            "counter",
            "cut",
            "datetime",
            "drawer",
            "feed",
            "group",
            "heading",
            "image",
            "initialize",
            "key_value",
            "line_spacing",
            "list",
            "margins",
            "markdown",
            "page",
            "pdf417",
            "qr_code",
            "raw",
            "rule",
            "self_test",
            "table",
            "text",
            "unicode",
            "utf8"
          ],
          "description": "The kind of block."
        }
      },
      "allOf": [
        {
          "if": {
            "properties": {
              "type": {
                "const": "text"
              }
            },
            "required": [
              "type"
            ]
          },
          "then": {
            "$ref": "#/$defs/block_text"
          }
        },
        {
          "if": {
            "properties": {
              "type": {
                "const": "heading"
              }
            },
            "required": [
              "type"
            ]
          },
          "then": {
            "$ref": "#/$defs/block_heading"
          }
        },
        {
          "if": {
            "properties": {
              "type": {
                "const": "markdown"
              }
            },
            "required": [
              "type"
            ]
          },
          "then": {
            "$ref": "#/$defs/block_markdown"
          }
        },
        {
          "if": {
            "properties": {
              "type": {
                "const": "unicode"
              }
            },
            "required": [
              "type"
            ]
          },
          "then": {
            "$ref": "#/$defs/block_unicode"
          }
        },
        {
          "if": {
            "properties": {
              "type": {
                "const": "utf8"
              }
            },
            "required": [
              "type"
            ]
          },
          "then": {
            "$ref": "#/$defs/block_utf8"
          }
        },
        {
          "if": {
            "properties": {
              "type": {
                "const": "feed"
              }
            },
            "required": [
              "type"
            ]
          },
          "then": {
            "$ref": "#/$defs/block_feed"
          }
        },
        {
          "if": {
            "properties": {
              "type": {
                "const": "rule"
              }
            },
            "required": [
              "type"
            ]
          },
          "then": {
            "$ref": "#/$defs/block_rule"
          }
        },
        {
          "if": {
            "properties": {
              "type": {
                "const": "key_value"
              }
            },
            "required": [
              "type"
            ]
          },
          "then": {
            "$ref": "#/$defs/block_key_value"
          }
        },
        {
          "if": {
            "properties": {
              "type": {
                "const": "columns"
              }
            },
            "required": [
              "type"
            ]
          },
          "then": {
            "$ref": "#/$defs/block_columns"
          }
        },
        {
          "if": {
            "properties": {
              "type": {
                "const": "table"
              }
            },
            "required": [
              "type"
            ]
          },
          "then": {
            "$ref": "#/$defs/block_table"
          }
        },
        {
          "if": {
            "properties": {
              "type": {
                "const": "list"
              }
            },
            "required": [
              "type"
            ]
          },
          "then": {
            "$ref": "#/$defs/block_list"
          }
        },
        {
          "if": {
            "properties": {
              "type": {
                "const": "box"
              }
            },
            "required": [
              "type"
            ]
          },
          "then": {
            "$ref": "#/$defs/block_box"
          }
        },
        {
          "if": {
            "properties": {
              "type": {
                "const": "qr_code"
              }
            },
            "required": [
              "type"
            ]
          },
          "then": {
            "$ref": "#/$defs/block_qr_code"
          }
        },
        {
          "if": {
            "properties": {
              "type": {
                "const": "barcode"
              }
            },
            "required": [
              "type"
            ]
          },
          "then": {
            "$ref": "#/$defs/block_barcode"
          }
        },
        {
          "if": {
            "properties": {
              "type": {
                "const": "pdf417"
              }
            },
            "required": [
              "type"
            ]
          },
          "then": {
            "$ref": "#/$defs/block_pdf417"
          }
        },
        {
          "if": {
            "properties": {
              "type": {
                "const": "image"
              }
            },
            "required": [
              "type"
            ]
          },
          "then": {
            "$ref": "#/$defs/block_image"
          }
        },
        {
          "if": {
            "properties": {
              "type": {
                "const": "cut"
              }
            },
            "required": [
              "type"
            ]
          },
          "then": {
            "$ref": "#/$defs/block_cut"
          }
        },
        {
          "if": {
            "properties": {
              "type": {
                "const": "drawer"
              }
            },
            "required": [
              "type"
            ]
          },
          "then": {
            "$ref": "#/$defs/block_drawer"
          }
        },
        {
          "if": {
            "properties": {
              "type": {
                "const": "beep"
              }
            },
            "required": [
              "type"
            ]
          },
          "then": {
            "$ref": "#/$defs/block_beep"
          }
        },
        {
          "if": {
            "properties": {
              "type": {
                "const": "raw"
              }
            },
            "required": [
              "type"
            ]
          },
          "then": {
            "$ref": "#/$defs/block_raw"
          }
        },
        {
          "if": {
            "properties": {
              "type": {
                "const": "initialize"
              }
            },
            "required": [
              "type"
            ]
          },
          "then": {
            "$ref": "#/$defs/block_initialize"
          }
        },
        {
          "if": {
            "properties": {
              "type": {
                "const": "code_page"
              }
            },
            "required": [
              "type"
            ]
          },
          "then": {
            "$ref": "#/$defs/block_code_page"
          }
        },
        {
          "if": {
            "properties": {
              "type": {
                "const": "charset"
              }
            },
            "required": [
              "type"
            ]
          },
          "then": {
            "$ref": "#/$defs/block_charset"
          }
        },
        {
          "if": {
            "properties": {
              "type": {
                "const": "line_spacing"
              }
            },
            "required": [
              "type"
            ]
          },
          "then": {
            "$ref": "#/$defs/block_line_spacing"
          }
        },
        {
          "if": {
            "properties": {
              "type": {
                "const": "margins"
              }
            },
            "required": [
              "type"
            ]
          },
          "then": {
            "$ref": "#/$defs/block_margins"
          }
        },
        {
          "if": {
            "properties": {
              "type": {
                "const": "group"
              }
            },
            "required": [
              "type"
            ]
          },
          "then": {
            "$ref": "#/$defs/block_group"
          }
        },
        {
          "if": {
            "properties": {
              "type": {
                "const": "page"
              }
            },
            "required": [
              "type"
            ]
          },
          "then": {
            "$ref": "#/$defs/block_page"
          }
        },
        {
          "if": {
            "properties": {
              "type": {
                "const": "counter"
              }
            },
            "required": [
              "type"
            ]
          },
          "then": {
            "$ref": "#/$defs/block_counter"
          }
        },
        {
          "if": {
            "properties": {
              "type": {
                "const": "datetime"
              }
            },
            "required": [
              "type"
            ]
          },
          "then": {
            "$ref": "#/$defs/block_datetime"
          }
        },
        {
          "if": {
            "properties": {
              "type": {
                "const": "self_test"
              }
            },
            "required": [
              "type"
            ]
          },
          "then": {
            "$ref": "#/$defs/block_self_test"
          }
        }
      ]
    },
    "options": {
      "type": "object",
      "properties": {
        "cut": {
          "enum": [
            "none",
            "partial",
            "full"
          ],
          "description": "How the job ends.",
          "default": "partial"
        },
        "feed": {
          "type": "integer",
          "minimum": 0,
          "maximum": 255,
          "description": "Extra dots fed before the cut.",
          "default": 0
        },
        "copies": {
          "type": "integer",
          "minimum": 1,
          "maximum": 20,
          "default": 1
        },
        "priority": {
          "type": "integer",
          "minimum": -100,
          "maximum": 100,
          "description": "Higher priorities print first.",
          "default": 0
        },
        "open_drawer": {
          "type": "boolean",
          "description": "Kick the cash drawer after printing.",
          "default": false
        },
        "beep": {
          "type": "boolean",
          "description": "Beep after printing.",
          "default": false
        },
        "unicode": {
          "enum": [
            "image",
            "transliterate"
          ],
          "description": "How text blocks print characters the printer's fonts lack.",
          "default": "image"
        }
      },
      "additionalProperties": false
    },
    "document": {
      "type": "object",
      "properties": {
        "$schema": {
          "type": "string"
        },
        "version": {
          "const": 1,
          "description": "Schema version."
        },
        "metadata": {
          "type": "object",
          "description": "Free-form data stored with the job. label is shown in the job list.",
          "properties": {
            "label": {
              "type": "string",
              "maxLength": 200
            }
          }
        },
        "options": {
          "$ref": "#/$defs/options"
        },
        "blocks": {
          "$ref": "#/$defs/blocks"
        }
      },
      "additionalProperties": false,
      "required": [
        "blocks"
      ]
    },
    "block_text": {
      "type": "object",
      "properties": {
        "type": {
          "const": "text"
        },
        "content": {
          "type": "string",
          "description": "Text to print. Characters the printer's fonts lack (emoji, CJK, ...) are drawn as an image when options.unicode is \"image\".",
          "maxLength": 65536
        },
        "spans": {
          "type": "array",
          "description": "Rich text: runs with their own styles, printed as one paragraph.",
          "minItems": 1,
          "maxItems": 500,
          "items": {
            "type": "object",
            "properties": {
              "content": {
                "type": "string",
                "maxLength": 65536
              },
              "style": {
                "$ref": "#/$defs/style"
              }
            },
            "additionalProperties": false,
            "required": [
              "content"
            ]
          }
        },
        "style": {
          "$ref": "#/$defs/style"
        },
        "align": {
          "$ref": "#/$defs/align"
        },
        "wrap": {
          "type": "boolean",
          "description": "Word-wrap at the paper width. When false the printer wraps mid-word.",
          "default": true
        }
      },
      "additionalProperties": false,
      "required": [
        "type"
      ],
      "description": "A paragraph of text, word-wrapped to the paper width. Give either content or spans.",
      "oneOf": [
        {
          "required": [
            "content"
          ]
        },
        {
          "required": [
            "spans"
          ]
        }
      ]
    },
    "block_heading": {
      "type": "object",
      "properties": {
        "type": {
          "const": "heading"
        },
        "content": {
          "type": "string",
          "description": "Text to print. Characters the printer's fonts lack (emoji, CJK, ...) are drawn as an image when options.unicode is \"image\".",
          "maxLength": 65536
        },
        "level": {
          "type": "integer",
          "minimum": 1,
          "maximum": 6,
          "default": 1
        },
        "align": {
          "$ref": "#/$defs/align"
        }
      },
      "additionalProperties": false,
      "required": [
        "type",
        "content"
      ],
      "description": "A heading in the same styles as Markdown headings."
    },
    "block_markdown": {
      "type": "object",
      "properties": {
        "type": {
          "const": "markdown"
        },
        "content": {
          "type": "string",
          "maxLength": 262144
        },
        "links": {
          "enum": [
            "inline",
            "footnotes",
            "qr",
            "hide"
          ],
          "description": "How links are printed.",
          "default": "inline"
        },
        "images": {
          "type": "boolean",
          "description": "Print ![images](src). When false the alt text is printed.",
          "default": true
        }
      },
      "additionalProperties": false,
      "required": [
        "type",
        "content"
      ],
      "description": "GitHub-flavoured Markdown: headings, emphasis, lists, task lists, tables, quotes, code, links, images, footnotes and :emoji: shortcodes."
    },
    "block_unicode": {
      "type": "object",
      "properties": {
        "type": {
          "const": "unicode"
        },
        "content": {
          "type": "string",
          "maxLength": 65536
        },
        "scale": {
          "type": "number",
          "minimum": 1,
          "maximum": 8,
          "default": 2,
          "description": "Dots per font pixel. 1.5 matches the printer's Font A."
        },
        "bold": {
          "type": "boolean",
          "default": false
        },
        "invert": {
          "type": "boolean",
          "description": "White on black.",
          "default": false
        },
        "align": {
          "$ref": "#/$defs/align"
        },
        "line_gap": {
          "type": "integer",
          "minimum": 0,
          "maximum": 255,
          "description": "Extra dots between lines."
        },
        "wrap": {
          "type": "boolean",
          "default": true
        },
        "weight": {
          "type": "integer",
          "minimum": 0,
          "maximum": 4,
          "description": "Extra dots added to each stroke of non-emoji glyphs. Default 1 below scale 3, matching the printer's own fonts."
        },
        "solid_emoji": {
          "type": "boolean",
          "default": false,
          "description": "Print emoji solid black. By default their solid areas are shaded grey, which reads better next to text."
        }
      },
      "additionalProperties": false,
      "required": [
        "type",
        "content"
      ],
      "description": "Text drawn as an image with GNU Unifont, so every Unicode character prints: emoji, kanji, Arabic, symbols. Arabic and Hebrew are not shaped or reordered."
    },
    "block_utf8": {
      "type": "object",
      "properties": {
        "type": {
          "const": "utf8"
        },
        "content": {
          "type": "string",
          "maxLength": 65536
        },
        "scale": {
          "type": "number",
          "minimum": 1,
          "maximum": 8,
          "default": 2,
          "description": "Dots per font pixel. 1.5 matches the printer's Font A."
        },
        "bold": {
          "type": "boolean",
          "default": false
        },
        "invert": {
          "type": "boolean",
          "description": "White on black.",
          "default": false
        },
        "align": {
          "$ref": "#/$defs/align"
        },
        "line_gap": {
          "type": "integer",
          "minimum": 0,
          "maximum": 255,
          "description": "Extra dots between lines."
        },
        "wrap": {
          "type": "boolean",
          "default": true
        },
        "weight": {
          "type": "integer",
          "minimum": 0,
          "maximum": 4,
          "description": "Extra dots added to each stroke of non-emoji glyphs. Default 1 below scale 3, matching the printer's own fonts."
        },
        "solid_emoji": {
          "type": "boolean",
          "default": false,
          "description": "Print emoji solid black. By default their solid areas are shaded grey, which reads better next to text."
        }
      },
      "additionalProperties": false,
      "required": [
        "type",
        "content"
      ],
      "description": "Alias of unicode."
    },
    "block_feed": {
      "type": "object",
      "properties": {
        "type": {
          "const": "feed"
        },
        "lines": {
          "type": "integer",
          "minimum": 0,
          "maximum": 255
        },
        "dots": {
          "type": "integer",
          "minimum": 0,
          "maximum": 255,
          "description": "1 dot is 0.125 mm."
        }
      },
      "additionalProperties": false,
      "required": [
        "type"
      ],
      "description": "Feed paper. Give lines or dots.",
      "oneOf": [
        {
          "required": [
            "lines"
          ]
        },
        {
          "required": [
            "dots"
          ]
        }
      ]
    },
    "block_rule": {
      "type": "object",
      "properties": {
        "type": {
          "const": "rule"
        },
        "char": {
          "type": "string",
          "description": "The character repeated across the line.",
          "minLength": 1,
          "maxLength": 1,
          "default": "─"
        },
        "style": {
          "$ref": "#/$defs/style"
        }
      },
      "additionalProperties": false,
      "required": [
        "type"
      ],
      "description": "A full-width horizontal line."
    },
    "block_key_value": {
      "type": "object",
      "properties": {
        "type": {
          "const": "key_value"
        },
        "key": {
          "type": "string",
          "maxLength": 4096
        },
        "value": {
          "type": "string",
          "maxLength": 4096
        },
        "leader": {
          "type": "string",
          "description": "Fills the gap between key and value.",
          "minLength": 1,
          "maxLength": 1,
          "default": " "
        },
        "key_style": {
          "$ref": "#/$defs/style"
        },
        "value_style": {
          "$ref": "#/$defs/style"
        }
      },
      "additionalProperties": false,
      "required": [
        "type",
        "key",
        "value"
      ],
      "description": "A label on the left and a value on the right, like a receipt line item."
    },
    "block_columns": {
      "type": "object",
      "properties": {
        "type": {
          "const": "columns"
        },
        "columns": {
          "type": "array",
          "minItems": 1,
          "maxItems": 8,
          "items": {
            "type": "object",
            "properties": {
              "content": {
                "type": "string",
                "maxLength": 4096
              },
              "align": {
                "$ref": "#/$defs/align"
              },
              "width": {
                "type": "integer",
                "minimum": 1,
                "maximum": 100,
                "description": "Relative width; columns share the line in proportion.",
                "default": 1
              }
            },
            "additionalProperties": false,
            "required": [
              "content"
            ]
          }
        },
        "style": {
          "$ref": "#/$defs/style"
        },
        "border": {
          "type": "boolean",
          "description": "Separate columns with │.",
          "default": false
        }
      },
      "additionalProperties": false,
      "required": [
        "type",
        "columns"
      ],
      "description": "Text side by side in columns that wrap independently."
    },
    "block_table": {
      "type": "object",
      "properties": {
        "type": {
          "const": "table"
        },
        "headers": {
          "type": "array",
          "maxItems": 16,
          "items": {
            "type": "string",
            "maxLength": 1024
          }
        },
        "rows": {
          "type": "array",
          "maxItems": 1000,
          "items": {
            "type": "array",
            "maxItems": 16,
            "items": {
              "type": [
                "string",
                "number"
              ]
            }
          }
        },
        "align": {
          "type": "array",
          "maxItems": 16,
          "items": {
            "$ref": "#/$defs/align"
          },
          "description": "Alignment of each column."
        },
        "border": {
          "type": "boolean",
          "description": "Separate columns with │.",
          "default": false
        },
        "style": {
          "$ref": "#/$defs/style"
        },
        "header_style": {
          "$ref": "#/$defs/style"
        }
      },
      "additionalProperties": false,
      "required": [
        "type",
        "rows"
      ],
      "description": "A table with optional headers. Columns are sized to their content and wrap when the table is too wide."
    },
    "block_list": {
      "type": "object",
      "properties": {
        "type": {
          "const": "list"
        },
        "items": {
          "type": "array",
          "minItems": 1,
          "maxItems": 1000,
          "items": {
            "type": "string",
            "maxLength": 4096
          }
        },
        "ordered": {
