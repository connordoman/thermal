      "type": "object",
      "properties": {
        "type": {
          "const": "page"
        },
        "width": {
          "type": "integer",
          "minimum": 1,
          "maximum": 1024,
          "description": "Page area width in dots; default the paper width."
        },
        "height": {
          "type": "integer",
          "minimum": 1,
          "maximum": 2400,
          "description": "Page area height in dots.",
          "default": 400
        },
        "x": {
