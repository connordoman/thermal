          "type": "integer",
          "minimum": 0,
          "maximum": 1023,
          "description": "Printable width in dots; 0 means the rest of the paper."
        }
      },
      "additionalProperties": false,
      "required": [
        "type"
      ],
      "description": "Set the left margin and printable width (GS L, GS W) for following content."
