        },
        "border": {
          "type": "boolean",
          "description": "Separate columns with │.",
          "default": false
        },
        "style": {
          "$ref": "#/$defs/style"
        },
        "header_style": {
          "$ref": "#/$defs/style"
        }
      },
      "additionalProperties": false,
      "required": [
        "type",
        "rows"
      ],
      "description": "A table with optional headers. It fills the line, each column getting a share in proportion to its widest cell; when the content is wider than the paper, cells wrap."
    },
    "block_list": {
