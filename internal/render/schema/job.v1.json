          "type": "integer",
          "minimum": 0,
          "maximum": 15,
          "description": "0 USA, 1 France, 2 Germany, 3 UK, 4 Denmark I, 5 Sweden, 6 Italy, 7 Spain I, 8 Japan, 9 Norway, 10 Denmark II, 11 Spain II, 12 Latin America, 13 Korea, 14 Slovenia/Croatia, 15 China."
        }
      },
      "additionalProperties": false,
      "required": [
