        },
        "align": {
          "$ref": "#/$defs/align"
        },
        "caption": {
          "type": "string",
          "description": "Printed below the code in the small font.",
          "maxLength": 1024
        }
      },
      "additionalProperties": false,
      "required": [
        "type",
        "content"
      ],
      "description": "A QR code (GS ( k)."
