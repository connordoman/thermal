        "type": {
          "const": "counter"
        },
        "set": {
          "type": "integer",
          "minimum": 0,
          "maximum": 65535,
          "description": "Set the counter before printing."
        },
        "from": {
          "type": "integer",
          "minimum": 0,
          "maximum": 65535
        },
        "to": {
          "type": "integer",
          "minimum": 0,
          "maximum": 65535
        },
        "step": {
          "type": "integer",
          "minimum": 0,
          "maximum": 255,
          "default": 1
        },
        "repeat": {
          "type": "integer",
          "minimum": 0,
          "maximum": 255,
          "default": 1
        },
        "digits": {
          "type": "integer",
          "minimum": 0,
          "maximum": 5,
          "description": "0 prints as many digits as needed.",
          "default": 0
        },
        "pad": {
          "enum": [
            "spaces",
            "zeros",
            "left"
          ],
          "default": "spaces"
        },
        "prefix": {
          "type": "string",
          "maxLength": 256
        },
        "style": {
          "$ref": "#/$defs/style"
        },
        "align": {
          "$ref": "#/$defs/align"
        }
      },
      "additionalProperties": false,
      "required": [
        "type"
      ],
      "description": "Print the printer's serial number counter, then step it."
    },
    "block_datetime": {
      "type": "object",
      "properties": {
        "type": {
          "const": "datetime"
        },
        "format": {
          "type": "string",
          "description": "date, time, datetime (default), rfc3339, or a Go time layout such as \"Mon 2 Jan 2006 15:04\".",
          "maxLength": 128
        },
        "timezone": {
          "type": "string",
          "description": "An IANA time zone such as America/Vancouver; default the server's.",
          "maxLength": 64
        },
        "prefix": {
          "type": "string",
          "maxLength": 256
        },
        "style": {
          "$ref": "#/$defs/style"
        },
        "align": {
          "$ref": "#/$defs/align"
        }
      },
      "additionalProperties": false,
      "required": [
        "type"
      ],
      "description": "The current date and time when the job is rendered."
    },
    "block_self_test": {
      "type": "object",
      "properties": {
        "type": {
          "const": "self_test"
        }
      },
      "additionalProperties": false,
      "required": [
        "type"
      ],
      "description": "Print the printer's self-test page."
    },
    "block_alert": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "type",
        "variant"
      ],
      "description": "A GitHub-style alert: a box with its title set into the top border, like an HTML fieldset (┌─ NOTE ───┐). The same as > [!NOTE] in Markdown.",
      "properties": {
        "type": {
          "const": "alert"
        },
        "variant": {
          "enum": [
            "NOTE",
            "TIP",
            "IMPORTANT",
            "WARNING",
            "CAUTION",
            "note",
            "tip",
            "important",
            "warning",
            "caution"
          ],
          "description": "The kind of alert, which is also the title unless title is given."
        },
        "title": {
          "type": "string",
          "maxLength": 40,
          "description": "Replaces the variant name in the top border. Printed in capitals and underlined."
        },
        "content": {
          "type": "string",
          "maxLength": 65536,
          "description": "Plain text inside the box; newlines start new lines."
        },
        "markdown": {
          "type": "string",
          "maxLength": 262144,
          "description": "Markdown inside the box, after content: paragraphs, lists, code, tables, even nested alerts."
        },
        "links": {
          "enum": [
            "inline",
            "footnotes",
            "qr",
            "hide"
          ],
          "default": "inline",
          "description": "How links in markdown are printed."
        },
        "style": {
          "$ref": "#/$defs/style",
          "description": "Styles the box: fontWeight bold draws heavier lines, borderStyle double draws double lines, marginLeft and width narrow it. Other text properties are inherited by the contents, which are always left-aligned."
        }
      }
    }
  }
}
